# Copy to .env and adjust. Never commit .env.

# API
PORT=3000
NODE_ENV=development

# PostgreSQL (docker-compose maps host 5433 -> container 5432)
DB_HOST=localhost
DB_PORT=5433
DB_USER=lifeledger
DB_PASSWORD=lifeledger
DB_NAME=lifeledger

# Redis / BullMQ (host 6380 avoids clashing with a local Redis/Valkey on 6379)
REDIS_HOST=localhost
REDIS_PORT=6380

# Auth
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# AWS (S3 documents, SES email, SNS notifications)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
SES_FROM_EMAIL=
